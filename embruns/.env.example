# Copier en .env.local et compléter. Ne jamais committer de vraie valeur.

# Supabase (projet en région UE)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Côté serveur uniquement (pages publiques, tâches planifiées, mode démo)
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL publique de l'app (liens magiques, QR codes, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tests de base de données (Postgres où l'on peut créer des bases jetables)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Compte de démo partagé (jamais une vraie adresse : aucun email n'y est envoyé)
DEMO_USER_EMAIL=demo@example.com

# API Claude (côté serveur uniquement). Sans clé, les explications sont
# générées par le code à partir des chiffres calculés.
ANTHROPIC_API_KEY=
# Modèle pour la rédaction courte (explications de prix)
CLAUDE_MODEL_WRITING=claude-opus-5-5
